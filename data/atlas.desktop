[Desktop Entry]
Type=Application
Name=Atlas
GenericName=Workspace
Comment=File-centric workspace for project folders, PDFs, Markdown and terminal
Exec=atlas %f
Icon=folder
Terminal=false
Categories=Utility;FileManager;Office;Development;
StartupWMClass=atlas
MimeType=inode/directory;
