# AUR-Paket atlas-workspace. Baut das Release-Archiv des Tags v$pkgver.
# Nach einem neuen Tag: pkgver anpassen, `updpkgsums` und
# `makepkg --printsrcinfo > .SRCINFO` ausführen.

# Maintainer: Minux (https://github.com/MlNUX)
pkgname=atlas-workspace
pkgver=1.1.1
pkgrel=1
pkgdesc="File-centric desktop workspace with PDF, Markdown and terminal"
arch=('x86_64' 'aarch64')
url="https://github.com/MlNUX/atlas"
license=('GPL-3.0-or-later')
depends=(
  'qt6-base' 'qt6-declarative' 'qt6-wayland' 'qt6-svg' 'qt6-imageformats'
  'qt6-webengine' 'qt6-webchannel' 'qt6-positioning'
  'syntax-highlighting'      # KF6, QML-Modul org.kde.syntaxhighlighting
  'poppler-glib' 'cairo' 'glib2' 'fontconfig' 'wayland'
  'ripgrep'
  'onnxruntime'             # „Formel als LaTeX“ (zur Laufzeit geladen)
  'gcc-libs' 'glibc'
)
makedepends=('rust' 'cargo' 'clang' 'pkgconf')
optdepends=(
  'xdg-utils: Dateien mit dem Standardprogramm öffnen'
  'systemd: App-Passwort des Kalenders verschlüsselt speichern (systemd-creds)'
  'hunspell-de: Rechtschreibprüfung Deutsch'
  'hunspell-en_us: Rechtschreibprüfung Englisch'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')   # vor dem Hochladen: updpkgsums
_srcname="atlas-$pkgver"

prepare() {
  cd "$_srcname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_srcname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # cxx-qt-build fragt Qt über qmake ab; Arch nennt es qmake6.
  export QMAKE=/usr/bin/qmake6
  export ATLAS_RG_BIN=/usr/bin/rg
  cargo build --frozen --release -p atlas-app
}

check() {
  cd "$_srcname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  export QMAKE=/usr/bin/qmake6
  cargo test --frozen --release -p atlas-core
}

package() {
  cd "$_srcname"
  install -Dm755 target/release/atlas "$pkgdir/usr/bin/atlas"
  install -Dm644 data/atlas.desktop "$pkgdir/usr/share/applications/atlas.desktop"
  install -Dm644 data/atlas.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/atlas.svg"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 crates/atlas-app/web/vendor/README.md "$pkgdir/usr/share/licenses/$pkgname/vendor/README.md"
  for lib in katex mermaid highlight; do
    install -Dm644 "crates/atlas-app/web/vendor/$lib/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/vendor/$lib/LICENSE"
  done
}
